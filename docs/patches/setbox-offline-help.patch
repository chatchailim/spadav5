index 0000000..ac97f3d
--- /dev/null
+++ b/public-help-ui.test.js
@@ -0,0 +1,87 @@
+"use strict";
+
+// หน้า Help ออฟไลน์ (public/help.html) — ตรวจสิ่งที่ต้องคงอยู่เสมอ
+//
+// ทำไมต้องมีเทสต์นี้
+//   Setbox ต้องใช้ได้ในโรงงานที่ไม่มีอินเทอร์เน็ต และเซิร์ฟเวอร์ปิด script จากภายนอกทั้งหมด (CSP)
+//   หน้านี้จึงต้องเป็นไฟล์นิ่ง ไม่มี script ไม่เรียกอะไรออกนอกเครื่อง
+//   ถ้ามีใครสร้างหน้านี้ใหม่แล้วฝังลิงก์ CDN หรือ script เข้ามา เทสต์นี้ต้องล้ม
+//
+// สิ่งที่ไม่ได้ตรวจ: ความถูกต้องของเนื้อหาคู่มือเทียบกับพฤติกรรมระบบ (ต้องให้คนอ่าน)
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawn } = require("node:child_process");
+const { stopServer, removeTree } = require("./test-helpers");
+const { SECURITY_HEADERS } = require("./http-guard");
+
+const PUBLIC = path.join(__dirname, "public");
+const help = fs.readFileSync(path.join(PUBLIC, "help.html"), "utf8");
+const PAGES = ["index", "admin", "business", "executive", "me"];
+
+test("หน้า Help ไม่เรียกอะไรออกนอกเครื่องและไม่มี script", () => {
+  assert.doesNotMatch(help, /<script/iu, "ห้ามมี <script> (CSP ปิด script ทั้งหมดอยู่แล้ว)");
+  assert.doesNotMatch(help, /\b(?:href|src)\s*=\s*["']?\s*(?:https?:)?\/\//iu, "ห้ามลิงก์/ฝังทรัพยากรภายนอก");
+  assert.doesNotMatch(help, /@import|url\(\s*["']?(?:https?:)?\/\//iu, "ห้าม @import/url() ภายนอก");
+  assert.doesNotMatch(help, /<(?:iframe|object|embed|link)\b/iu);
+});
+
+test("หน้า Help มีเนื้อหาครบ: แผนภาพ สารบัญ อภิธานศัพท์", () => {
+  assert.ok(help.length > 50_000, "ไฟล์เล็กผิดปกติ: เนื้อหาน่าจะหาย");
+  assert.ok((help.match(/<svg\b/gu) || []).length >= 13, "แผนภาพต้องครบ 13 ภาพ");
+  assert.match(help, /อภิธานศัพท์เทคนิค/u);
+  assert.match(help, /<nav class="side"/u);
+});
+
+test("หน้า Help ไม่มีหมายเหตุภายในหลุดมา", () => {
+  assert.doesNotMatch(help, /<!--\s*internal/iu);
+  assert.doesNotMatch(help, /\bPR\s*#\d+/u, "ห้ามมีเลข PR ของงานภายใน");
+  assert.doesNotMatch(help, /Claude/u);
+});
+
+test("ลิงก์สารบัญภายในหน้า Help ชี้ไปหัวข้อที่มีอยู่จริงทุกลิงก์", () => {
+  const ids = new Set([...help.matchAll(/\sid="([^"]+)"/gu)].map(m => m[1]));
+  const broken = [...help.matchAll(/href="#([^"]+)"/gu)]
+    .map(m => decodeURIComponent(m[1])).filter(id => !ids.has(id));
+  assert.deepEqual(broken, [], `ลิงก์เสีย: ${broken.join(", ")}`);
+});
+
+test("ทุกหน้าจอหลักมีปุ่ม Help และโหลดสไตล์ของปุ่ม", () => {
+  assert.ok(fs.existsSync(path.join(PUBLIC, "help-link.css")));
+  for (const page of PAGES) {
+    const html = fs.readFileSync(path.join(PUBLIC, `${page}.html`), "utf8");
+    assert.match(html, /<a class="help-link" href="\/help\.html"[^>]*>Help<\/a>/u, `${page}.html ไม่มีปุ่ม Help`);
+    assert.match(html, /href="\/help-link\.css"/u, `${page}.html ไม่ได้โหลด help-link.css`);
+  }
+});
+
+test("เซิร์ฟเวอร์ส่ง /help.html ผ่านด่าน CSP ได้และไม่ต้องเข้าสู่ระบบ", async t => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "onevault-help-"));
+  const server = spawn(process.execPath, [path.join(__dirname, "server.js")], {
+    env: { ...process.env, PORT: "0", WAREHOUSE_PATH: path.join(root, "w.db"),
+      FILE_VAULT_PATH: path.join(root, "files") },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  t.after(async () => { await stopServer(server); removeTree(root); });
+  const port = await new Promise((resolve, reject) => {
+    let output = "";
+    const timer = setTimeout(() => reject(new Error(`เซิร์ฟเวอร์ไม่ตอบ: ${output}`)), 20000);
+    server.stdout.on("data", chunk => {
+      output += chunk;
+      const match = /listening on :(\d+)/u.exec(output);
+      if (match) { clearTimeout(timer); resolve(Number(match[1])); }
+    });
+    server.stderr.on("data", chunk => { output += chunk; });
+    server.on("error", reject);
+  });
+
+  const response = await fetch(`http://127.0.0.1:${port}/help.html`);
+  assert.equal(response.status, 200);
+  assert.match(response.headers.get("content-type") || "", /text\/html/u);
+  const csp = response.headers.get("content-security-policy") || SECURITY_HEADERS["Content-Security-Policy"];
+  assert.match(csp, /script-src 'self'/u);
+  assert.match(await response.text(), /คู่มือการใช้งาน/u);
+});
