+<td><code>CUSTODIAN</code></td>
+<td>ผู้ดูแลเก็บรักษา</td>
+</tr>
+<tr>
+<td><code>AUTHOR</code></td>
+<td>ผู้เขียน/ผู้จัดทำ</td>
+</tr>
+<tr>
+<td><code>REVIEWER</code></td>
+<td>ผู้ตรวจทาน</td>
+</tr>
+<tr>
+<td><code>APPROVER</code></td>
+<td>ผู้อนุมัติ</td>
+</tr>
+<tr>
+<td><code>SIGNER</code></td>
+<td>ผู้ลงนาม</td>
+</tr>
+<tr>
+<td><code>PARTNER</code></td>
+<td>คู่สัญญา/คู่ค้า</td>
+</tr>
