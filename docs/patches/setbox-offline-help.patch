+/* ปุ่ม Help ที่ลิงก์ไปคู่มือออฟไลน์ (/help.html) ใช้สีตัวอักษรของส่วนที่วางอยู่ จึงเข้ากับทุกหน้า */
+a.help-link {
+  display: inline-flex; align-items: center; min-height: 36px; padding: 4px 14px;
+  border: 1px solid currentColor; border-radius: 8px; font-size: 14px; line-height: 1.2;
+  color: inherit; text-decoration: none; white-space: nowrap; margin-left: 8px;
+}
+a.help-link:hover, a.help-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
+.help-side { padding: 8px 12px; }
+.help-side a.help-link { margin-left: 0; }
