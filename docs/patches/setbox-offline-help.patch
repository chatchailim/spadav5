+@media (prefers-color-scheme:dark){:root{--bg:#0b1b2b;--panel:#122535;--line:#294252;--text:#f5f1e7;--muted:#9eb0bf;--accent:#51d9be;--link:#72b8f5;--code:#1c3447}}
